.nav-button { color: #aab8ce; background: transparent; border: 0; border-radius: 10px; padding: 13px 15px; text-align: left; }
.nav-button:hover { background: #1a2940; color: #ffffff; }
.nav-button:checked { background: #183b43; color: #65f0d0; }
