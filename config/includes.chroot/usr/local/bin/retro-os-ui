.hero-title { color: #ffffff; font-size: 34px; font-weight: 900; }
.game-row { background: #111d2e; border: 1px solid #263a56; border-radius: 12px; padding: 12px; }
entry, spinbutton, combobox, textview { background: #111d2e; color: #edf3ff; border: 1px solid #344964; border-radius: 8px; padding: 8px; }
