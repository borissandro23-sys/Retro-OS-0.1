#!/usr/bin/env python3
"""Retro OS console-style launcher for the Debian Live image."""
from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import threading
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

APP_DIR = Path.home() / ".config" / "retro-os"
SETTINGS_FILE = APP_DIR / "settings.json"
DEFAULT_LIBRARY = Path.home() / "Games"
ROM_EXTENSIONS = {
    ".nes", ".fds", ".unf", ".unif", ".sfc", ".smc", ".gba", ".gb",
    ".gbc", ".n64", ".z64", ".v64", ".nds", ".3ds", ".cia", ".iso",
    ".cue", ".chd", ".pbp", ".cso", ".md", ".gen", ".32x", ".zip",
    ".7z", ".a26", ".a52", ".a78", ".j64", ".lnx", ".pce", ".sg",
    ".gg", ".sms", ".ws", ".wsc"
}
CORE_HINTS = {
    ".nes": ("fceumm", "nestopia"), ".fds": ("fceumm", "nestopia"),
    ".sfc": ("snes9x", "bsnes"), ".smc": ("snes9x", "bsnes"),
    ".gba": ("mgba", "gpsp"), ".gb": ("gambatte", "gearboy"),
    ".gbc": ("gambatte", "gearboy"), ".nds": ("melonds", "desmume"),
    ".n64": ("mupen64plus_next",), ".z64": ("mupen64plus_next",),
    ".v64": ("mupen64plus_next",), ".md": ("genesis_plus_gx", "picodrive"),
    ".gen": ("genesis_plus_gx", "picodrive"), ".32x": ("picodrive",),
    ".iso": ("pcsx_rearmed",), ".cue": ("pcsx_rearmed",),
    ".chd": ("pcsx_rearmed",), ".pbp": ("pcsx_rearmed",),
    ".cso": ("ppsspp",), ".3ds": ("citra",), ".cia": ("citra",),
    ".zip": ("fbneo", "mame"), ".7z": ("fbneo", "mame"),
}

CSS = """
